# 로컬 개발용 (이 세션의 Postgres). Supabase 프로젝트를 만들면 DATABASE_URL을
# Supabase의 Connection string(직접 연결 또는 pooler)으로 바꿔주세요.
DATABASE_URL=postgres://academy_app:REPLACE_ME@127.0.0.1:5432/academy_dev

# 세션 쿠키 서명용 비밀키. 배포 전에 반드시 무작위 값으로 교체하세요.
SESSION_SECRET=REPLACE_ME

# Supabase 프로젝트를 연결하면 채워주세요 (지금은 미사용 — Auth/Storage 등을
# supabase-js로 붙일 때 사용).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 카카오 알림톡 (src/lib/kakao.ts). 사업자등록 + 카카오 비즈니스 채널 개설 +
# 알림톡 중계사(Solapi, NHN Cloud Notification, Bizmsg 등) 계약 + 템플릿
# 사전승인 후 채워주세요. 비어 있으면 실제 발송 없이 기록만 남기는 폴백
# 모드로 자동 동작합니다 (앱은 정상 작동).
KAKAO_ALIMTALK_PROVIDER_URL=
KAKAO_ALIMTALK_API_KEY=
KAKAO_PF_ID=

# 카카오톡 채널 인바운드 웹훅 (src/app/api/kakao/consultation/route.ts).
# 카카오 i 오픈빌더에서 이 앱의 스킬 서버 URL을
#   https://<배포주소>/api/kakao/consultation?secret=여기에_넣은_값
# 형태로 등록하세요. 무작위의 긴 문자열로 채우고 절대 공개하지 마세요.
KAKAO_WEBHOOK_SECRET=
